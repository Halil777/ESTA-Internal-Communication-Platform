# Application
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=esta_connect
DB_USER=esta_user
DB_PASS=esta_strong_password
DB_SYNCHRONIZE=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_key_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=7d

# Asterisk AMI
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_RECONNECT_MS=10000
ASTERISK_AMI_RECONNECT_MAX_MS=60000
ASTERISK_AMI_USER=esta_ami_user
ASTERISK_AMI_SECRET=esta_ami_password
ASTERISK_SIP_DOMAIN=10.10.20.231
ASTERISK_SIP_PORT=5060
ASTERISK_SIP_TRANSPORT=UDP
# Must match an existing transport section in Asterisk pjsip.conf, for example [transport-udp]
ASTERISK_PJSIP_TRANSPORT_SECTION=transport-udp
# Docker Asterisk uses pjsip.endpoints.conf, local Asterisk usually uses pjsip.conf
ASTERISK_PJSIP_CONFIG_FILE=pjsip.conf
ASTERISK_PROVISIONING_MODE=both

# SIP credential encryption key (32 chars)
SIP_ENCRYPTION_KEY=change_this_32_char_encryption_key

# Admin seed (first superadmin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
