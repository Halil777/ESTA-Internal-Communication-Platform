<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for local office network (SIP/HTTP) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.10.20.231</domain>
        <domain includeSubdomains="true">10.10.20.240</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
