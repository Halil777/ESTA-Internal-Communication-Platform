# Docker Compose defaults
ASTERISK_PUBLIC_IP=10.10.20.231
ASTERISK_LOCAL_NET=10.10.20.0/24
# Docker bridge network only. Do not set this to the phone LAN, otherwise
# Asterisk advertises its container IP in SDP and audio will fail.
ASTERISK_PJSIP_LOCAL_NET=172.16.0.0/12
RTP_START_PORT=10000
RTP_END_PORT=10100

# Asterisk local integration
ASTERISK_AMI_USER=esta_ami_user
ASTERISK_AMI_SECRET=change_this_ami_password
ASTERISK_ARI_USER=esta_ari_user
ASTERISK_ARI_SECRET=change_this_ari_password

# Backend secrets
JWT_SECRET=change_this_to_a_very_long_random_secret_key_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_too
SIP_ENCRYPTION_KEY=change_this_32_char_encryption_key

# Initial admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
